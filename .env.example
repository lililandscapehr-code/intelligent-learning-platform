# Database Configuration
DB_HOST=localhost
DB_USER=educational_app
DB_PASSWORD=change_me
DB_NAME=educational_platform
DB_PORT=3306
DB_SSL=false
DB_CONNECTION_LIMIT=5

# Authentication Configuration
JWT_SECRET=generate_a_random_secret_at_least_32_characters_long

# AI Configuration (server-side only; never expose keys in client code)
AI_PROVIDER=online
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace_with_online_provider_key
AI_MODEL=replace_with_text_or_vision_model
# Optional local alternative: AI_PROVIDER=ollama and OLLAMA_MODEL=qwen2.5:3b
